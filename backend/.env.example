NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://booking:CHANGE_DATABASE_PASSWORD@127.0.0.1:5432/booking_dev

# 下面是不可使用的占位值；本地 mock 不使用它们，真实登录前必须替换。
WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=REPLACE_WITH_YOUR_WECHAT_APP_SECRET
WECHAT_MOCK_LOGIN=true
WECHAT_MOCK_ADMIN=false
WECHAT_REQUEST_TIMEOUT_MS=10000

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

BUSINESS_PHONE=00000000000
BUSINESS_NAME=示例预约馆
BUSINESS_ADDRESS=上海市黄浦区人民广场（示例地址）
# GCJ-02 示例坐标；上线前定位自己的门店。
BUSINESS_LATITUDE=31.228827
BUSINESS_LONGITUDE=121.475213
SERVICE_PROVIDER_NAME=芳疗师
PRIVACY_OPERATOR=示例预约服务工作室（虚构主体）
PRIVACY_CONTACT_PHONE=00000000000

NO_SHOW_CRON=* * * * *
# 开发目录相对于 backend 工作目录；生产必须使用发布目录外的绝对路径。
THERAPIST_UPLOAD_DIR=./uploads/therapists
IMAGE_ORPHAN_RETENTION_HOURS=24
IMAGE_CLEANUP_CRON=17 3 * * *
RECYCLE_BIN_RETENTION_DAYS=30
RECYCLE_BIN_CLEANUP_CRON=7 3 * * *

LOG_LEVEL=info
LOG_RETENTION_DAYS=21
LOG_MAX_BYTES=10485760
# 开发示例目录相对于 backend；生产目录见 .env.production.example。
LOG_DIR=./logs
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# 可选异地备份镜像，默认不启用。配置自己的挂载目录后再取消注释。
# BACKUP_MIRROR_DIR=/mnt/booking-backup-mirror

ADMIN_DASHBOARD_ENABLED=true
METRICS_ENABLED=true
ALERT_5XX_THRESHOLD_5M=10
## Optional private-code review login (independent of local mock login).
REVIEW_LOGIN_ENABLED=false
# 不可用的公开占位码和已过期时间，只用于说明格式；启用前都须替换。
REVIEW_LOGIN_CODE=REPLACE_WITH_PRIVATE_RANDOM_REVIEW_CODE
REVIEW_LOGIN_EXPIRES_AT=2000-01-01T00:00:00+08:00
