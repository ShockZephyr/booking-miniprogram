# Copy to /etc/booking/production.env, chmod 600, and fill all required values.
NODE_ENV=production
PORT=3000
TRUST_PROXY_HOPS=1
DATABASE_URL=postgres://booking:CHANGE_DATABASE_PASSWORD@127.0.0.1:5432/booking_prod
JWT_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
JWT_EXPIRES_IN=7d
# 示例占位，不是真实微信凭据；使用者必须替换。
WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=REPLACE_WITH_YOUR_WECHAT_APP_SECRET
WECHAT_MOCK_LOGIN=false
WECHAT_MOCK_ADMIN=false
WECHAT_REQUEST_TIMEOUT_MS=10000
# 虚构门店资料和 GCJ-02 上海人民广场示例点，正式发布前替换。
BUSINESS_NAME=示例预约馆
BUSINESS_PHONE=00000000000
BUSINESS_ADDRESS=上海市黄浦区人民广场（示例地址）
BUSINESS_LATITUDE=31.228827
BUSINESS_LONGITUDE=121.475213
SERVICE_PROVIDER_NAME=芳疗师
PRIVACY_OPERATOR=示例预约服务工作室（虚构主体）
PRIVACY_CONTACT_PHONE=00000000000
THERAPIST_UPLOAD_DIR=/var/lib/booking/uploads
LOG_DIR=/var/log/booking
LOG_LEVEL=info
LOG_RETENTION_DAYS=186
LOG_MAX_BYTES=10485760
BACKUP_DIR=/var/backups/booking
BACKUP_RETENTION_DAYS=14
# 可选：独立挂载的异地备份镜像，默认不启用；配置自己的目录后再取消注释。
# BACKUP_MIRROR_DIR=/mnt/booking-backup-mirror
NO_SHOW_CRON=* * * * *
IMAGE_ORPHAN_RETENTION_HOURS=24
IMAGE_CLEANUP_CRON=17 3 * * *
RECYCLE_BIN_RETENTION_DAYS=30
RECYCLE_BIN_CLEANUP_CRON=7 3 * * *
ADMIN_DASHBOARD_ENABLED=true
METRICS_ENABLED=true
ALERT_5XX_THRESHOLD_5M=10
## Optional private-code review login. Keep mock switches false in production.
# Generate 32 random bytes as hex; do not put the code in the client or Git.
# Expiry format: YYYY-MM-DDTHH:mm:ss+08:00. Both fields are required when enabled.
REVIEW_LOGIN_ENABLED=false
# 下面是不可用的公开占位码和已过期时间示例，启用前必须替换。
REVIEW_LOGIN_CODE=REPLACE_WITH_PRIVATE_RANDOM_REVIEW_CODE
REVIEW_LOGIN_EXPIRES_AT=2000-01-01T00:00:00+08:00
