{
  "name": "wechat-booking-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "prestart": "npm run migrate",
    "start": "node src/server.js",
    "dev": "NODE_ENV=development node src/server.js",
    "migrate": "node src/scripts/migrate.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "images:cleanup": "node src/scripts/cleanupImages.js",
    "images:status": "node src/scripts/imageStorageStatus.js",
    "images:migrate": "node src/scripts/migrateImages.js",
    "backup": "node src/scripts/backup.js create",
    "backup:verify": "node src/scripts/backup.js verify",
    "backup:restore": "node src/scripts/backup.js restore",
    "backup:rehearse": "node src/scripts/rehearseRestore.js",
    "production:check": "node src/scripts/checkProduction.js",
    "ops:status": "node src/scripts/deploymentStatus.js",
    "test": "node --test tests/*.test.js",
    "test:db": "node --test --test-concurrency=1 tests/*.test.js",
    "opensource:check": "node --test tests/release/openSourceSnapshot.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
