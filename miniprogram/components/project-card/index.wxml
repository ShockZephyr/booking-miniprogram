<view class="project-card" bindtap="tap" aria-role="button" aria-label="{{actionLabel}}：{{project.name}}，{{project.durationMinutes}}分钟，{{project.priceText}}">
  <block wx:if="{{imageSource && !imageFailed}}"><image wx:for="{{imageRequests}}" wx:for-item="imageRequest" wx:key="key" class="cover" src="{{imageRequest.src}}" data-attempt="{{imageRequest.key}}" binderror="imageError" mode="aspectFill" lazy-load="{{true}}" aria-hidden="true" /></block>
  <view wx:elif="{{imageFailed}}" class="cover placeholder image-retry" catchtap="retryImage" aria-role="button" aria-label="重新加载{{project.name}}的图片">
    <view class="image-error-content">
      <text>加载失败</text>
      <view class="image-retry-label"><text>点击重试</text><image wx:if="{{!retryIconFailed}}" class="retry-icon" src="/assets/icons/image-retry.png" mode="aspectFit" binderror="retryIconError" aria-hidden="true" /></view>
    </view>
  </view>
  <view wx:else class="cover placeholder" aria-hidden="true">项目图片</view>
  <view class="info"><view class="name">{{project.name}}</view><view class="effect">{{project.effect || '效果待完善'}}</view><view class="meta"><text>{{project.durationMinutes}} 分钟</text><text class="price">{{project.priceText}}</text></view></view>
</view>
