.project-card { display:flex; align-items:center; gap:22rpx; padding:18rpx; background:#f8f7fc; border-radius:22rpx; min-height:176rpx; box-sizing:border-box; }
.cover { width:140rpx; height:140rpx; flex-shrink:0; border-radius:16rpx; background:#eae5f1; }
.placeholder { display:flex; align-items:center; justify-content:center; color:#6f6876; font-size:12px; }
.image-error-content { display:inline-flex; flex-direction:column; align-items:center; max-width:calc(100% - 8rpx); gap:4rpx; font-size:11px; line-height:1.4; }
.image-retry-label { display:inline-flex; align-items:center; justify-content:center; gap:2px; color:#5c556b; white-space:nowrap; }
.retry-icon { width:10px; height:10px; flex:0 0 10px; }
.info { flex:1; min-width:0; padding:4rpx 0; }
.name { font-size:30rpx; line-height:1.4; font-weight:600; color:#2f2f32; overflow-wrap:anywhere; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }
.effect { margin-top:8rpx; font-size:24rpx; line-height:1.45; color:#6f6876; overflow-wrap:anywhere; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }
.meta { display:flex; flex-wrap:wrap; justify-content:space-between; gap:8rpx 12rpx; margin-top:12rpx; font-size:24rpx; line-height:1.4; color:#6f6876; }
.price { color:#5c556b; font-weight:600; }
