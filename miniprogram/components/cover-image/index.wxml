<block wx:if="{{!imageFailed}}">
  <image wx:for="{{imageRequests}}" wx:key="key" class="photo" src="{{item.src}}" data-attempt="{{item.key}}" binderror="imageError" mode="aspectFill" aria-label="{{label}}" />
</block>
<view wx:else class="fallback"><text class="retry" catchtap="retry" aria-role="button">图片加载失败 · 点击重试</text></view>
