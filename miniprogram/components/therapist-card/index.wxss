.therapist-card { background:#fff; border-radius:24rpx; overflow:hidden; border:4rpx solid transparent; box-shadow:0 8rpx 24rpx rgba(92,85,107,.06); }
.selected { border-color:#6f5a82; }
.portrait { display:block; width:100%; height:320rpx; background:#eae5f1; }
.placeholder { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4rpx; color:#6f6876; font-size:24rpx; line-height:1.5; }
.image-retry-label { display:inline-flex; align-items:center; justify-content:center; gap:8rpx; color:#5c556b; white-space:nowrap; }
.retry-icon { width:24rpx; height:24rpx; flex:0 0 24rpx; }
.info { padding:20rpx; min-height:120rpx; }
.name { min-height:40rpx; line-height:1.35; font-size:30rpx; font-weight:700; color:#2f2f32; overflow-wrap:anywhere; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }
.tags { margin-top:12rpx; min-height:44rpx; display:flex; flex-wrap:nowrap; gap:8rpx; overflow:hidden; }
.tags text { display:inline-block; flex:0 0 auto; font-size:12px; line-height:1.4; color:#6f5a82; background:#f1edf7; border-radius:12rpx; padding:6rpx 10rpx; }

/* The booking roster shares image recovery with catalog cards, in a compact row. */
.booking { box-sizing:border-box; display:flex; align-items:center; gap:20rpx; width:100%; min-height:224rpx; padding:24rpx; border:0; border-radius:24rpx; }
.booking.card-pressed { background:#f3f0f7; }
.booking .portrait { flex:0 0 160rpx; width:160rpx; height:160rpx; margin-left:12rpx; border-radius:18rpx; overflow:hidden; }
.booking .placeholder { font-size:12px; }
.booking .info { flex:1; min-width:0; min-height:0; margin-left:14rpx; margin-right:18rpx; padding:0; }
.booking-heading { display:flex; align-items:center; justify-content:flex-start; gap:8rpx; min-width:0; }
.booking .name { display:block; flex:0 1 auto; min-width:0; min-height:0; font-size:32rpx; line-height:1.4; white-space:nowrap; text-overflow:ellipsis; }
.status-divider { flex:0 0 auto; color:#8c8593; font-size:24rpx; font-weight:700; line-height:1.4; }
/* Text is capped at 30 characters in JS; preserve the explicit six-dot suffix. */
.bio { display:-webkit-box; height:76rpx; margin-top:8rpx; overflow:hidden; color:#6f6876; font-size:26rpx; line-height:1.46; word-break:break-all; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
.availability { flex:0 0 auto; color:#6f6876; font-size:24rpx; font-weight:700; line-height:1.4; white-space:nowrap; }
.availability.available { color:#2b854a; }
.availability.off { color:#9a6600; }
.booking-tags { margin-top:10rpx; min-height:40rpx; white-space:nowrap; }
.chevron { flex:0 0 32rpx; width:32rpx; height:32rpx; transform:translateX(-8rpx) rotate(180deg); }
