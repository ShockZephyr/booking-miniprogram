.empty {
  min-height: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6f6876;
  font-size: 28rpx;
  line-height: 1.55;
  text-align: center;
  padding: 32rpx;
  box-sizing: border-box;
  overflow-wrap: anywhere;
}

.icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 36rpx;
  background: #e6e0f8;
  margin-bottom: 24rpx;
}
