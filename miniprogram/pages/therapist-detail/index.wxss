.detail-page { width:100%; max-width:520px; min-height:100vh; padding-bottom:calc(180rpx + env(safe-area-inset-bottom)); background:#f8f7fc; margin:0 auto; }
.hero-portrait { width:100%; display:block; min-height:400rpx; background:#eee8f4; }
.placeholder { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8rpx; color:#6f6876; font-size:28rpx; line-height:1.5; }
.image-retry-label { display:inline-flex; align-items:center; justify-content:center; gap:8rpx; color:#5c556b; white-space:nowrap; }
.retry-icon { width:24rpx; height:24rpx; flex:0 0 24rpx; }
.error-page { margin:24rpx; min-height:auto; border-radius:24rpx; background:#fff0f0; color:#7d343b; line-height:1.55; }
.profile-card { position:relative; margin:-42rpx 24rpx 0; padding:36rpx; border-radius:32rpx; background:#fff; box-shadow:0 8rpx 24rpx rgba(92,85,107,.05); }
.biography-card { margin-top:24rpx; }
.biography-card .section-title { margin-top:0; }
.therapist-name { font-size:48rpx; line-height:1.25; font-weight:700; margin:0 0 34rpx; overflow-wrap:anywhere; }
.section-title { margin-top:28rpx; font-size:34rpx; line-height:1.35; font-weight:700; }
.tags { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:18rpx; }
.tags text { color:#6f5a82; background:#f1edf7; border-radius:28rpx; padding:10rpx 22rpx; font-size:24rpx; line-height:1.4; overflow-wrap:anywhere; }
.bio { display:block; max-width:52em; white-space:pre-wrap; font-size:28rpx; line-height:1.8; margin-top:18rpx; color:#5c556b; overflow-wrap:anywhere; }
.bottom-bar { position:fixed; bottom:0; left:0; right:0; padding:20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background:rgba(248,247,252,.97); z-index:5; }
.bottom-bar .primary-button { width:100%; max-width:520px; margin:0 auto; }
