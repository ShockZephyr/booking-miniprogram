.login-card {
  padding: 42rpx 34rpx;
  margin-top: 80rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.3;
  overflow-wrap: anywhere;
  margin-bottom: 16rpx;
}

.login-button {
  margin-top: 40rpx;
}

.mock-panel {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #efeff2;
}

.mock-title {
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.45;
  color: #5c556b;
  margin-bottom: 16rpx;
}

.mock-input {
  min-height: 48px;
  border-radius: 24rpx;
  background: #f8f7fc;
  padding: 14rpx 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.mock-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 14rpx;
}

.mock-actions button {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  min-height: 48px;
  border-radius: 38rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
  padding: 12rpx 16rpx;
  margin: 0;
}

.mock-actions .admin-login {
  background: #e6e0f8;
}

.mock-actions .therapist-login {
  background: #e4f1e8;
  color: #365f45;
}

.profile {
  padding: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.profile > user-header {
  flex: 1;
  min-width: 0;
}

.settings {
  width: 48px !important;
  min-width: 48px;
  max-width: 48px;
  height: 48px !important;
  min-height: 48px;
  max-height: 48px;
  flex: 0 0 48px;
  border-radius: 24px;
  background: #f8f7fc;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 !important;
  margin: 0 0 0 auto !important;
  line-height: 48px;
}

.settings-icon {
  width: 38rpx;
  height: 38rpx;
}

.appointment-grid,
.admin-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.admin-grid {
  grid-template-columns: repeat(3, 1fr);
}

.entry {
  min-height: 136rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 26rpx;
  line-height: 1.4;
  padding: 14rpx 8rpx;
  text-align: center;
  overflow-wrap: anywhere;
  color: #5c556b;
}

.entry-icon {
  width: 58rpx;
  height: 58rpx;
}

@media (max-width: 340px) {
  .appointment-grid,
  .admin-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
.therapist-identity { padding:28rpx; margin-bottom:28rpx; }
.identity-label { color:#6f6876; font-size:24rpx; line-height:1.4; }
.identity-name { margin-top:8rpx; color:#2f2f32; font-size:34rpx; font-weight:800; line-height:1.35; }
.therapist-identity .muted { margin-top:8rpx; }
