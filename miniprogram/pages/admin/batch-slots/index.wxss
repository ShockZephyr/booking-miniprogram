.weekly {padding-bottom:calc(42rpx + env(safe-area-inset-bottom));}
.week-head {margin-bottom:24rpx;}
.heading,.row-head {font-size:32rpx;font-weight:700;}
.schedule-profile-card {box-sizing:border-box;width:100%;margin-bottom:22rpx;padding:24rpx;border-radius:28rpx;background:#ffffff;box-shadow:0 10rpx 28rpx rgba(92,85,107,0.09);}
.profile-identity {display:flex;align-items:center;gap:18rpx;min-width:0;}
.profile-avatar {display:block;flex:0 0 96rpx;width:96rpx;height:96rpx;overflow:hidden;border-radius:50%;background:#eee8f4;}
.profile-placeholder {display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2rpx;color:#6f6876;font-size:20rpx;line-height:1.2;text-align:center;}
.retry-icon {width:22rpx;height:22rpx;}
.profile-name {display:block;min-width:0;color:#2f2f32;font-size:32rpx;font-weight:700;line-height:1.4;overflow-wrap:anywhere;}
.profile-specialties {display:grid;grid-template-columns:auto minmax(0,1fr);align-items:start;column-gap:4rpx;width:100%;margin-top:18rpx;}
.specialty-label {padding:5rpx 0;color:#51475e;font-size:26rpx;font-weight:600;line-height:1.4;white-space:nowrap;}
.specialty-tags {display:flex;flex-wrap:wrap;align-items:flex-start;gap:8rpx;min-width:0;}
.specialty-tag {display:inline-block;box-sizing:border-box;max-width:100%;padding:5rpx 10rpx;border-radius:10rpx;color:#5c4f6d;background:#f1edf7;font-size:24rpx;line-height:1.4;overflow-wrap:anywhere;}
.specialty-empty {padding:5rpx 0;color:#6f6876;font-size:24rpx;line-height:1.4;}
@media (max-width:340px) {.profile-avatar {flex-basis:88rpx;width:88rpx;height:88rpx;}}
.tabs,.choices,.range,.field,.row-head {display:flex;align-items:center;}
.tabs {margin-top:18rpx;gap:4rpx;}
.tabs .tab {display:flex;align-items:center;justify-content:center;min-width:0;width:0;flex:1;height:44px;min-height:44px;margin:0;padding:0;line-height:1.35;white-space:nowrap;font-size:24rpx;border-radius:14rpx;color:#6a5a7c;background:#ffffff;}
.tabs .tab.active {color:#40374f;background:#e6e0f8;font-weight:700;}
.tabs .tab {position:relative;}
.dirty-dot {position:absolute;top:6rpx;right:6rpx;width:9rpx;height:9rpx;border-radius:50%;background:#8b5a23;}
.week-draft-hint,.week-notice {margin-top:14rpx;font-size:24rpx;line-height:1.5;}
.week-draft-hint {color:#6a5a7c;}
.week-notice {color:#943b46;}
.block {padding:24rpx;margin-bottom:18rpx;}
.projects-block {margin-bottom:48rpx;}
.row-head,.field {justify-content:space-between;gap:12rpx;}
.row-head {width:100%;}
.select-all {display:flex;align-items:center;justify-content:flex-end;flex:0 0 auto;margin-left:auto;min-height:44px;min-width:88rpx;padding:8rpx 0 8rpx 16rpx;color:#554b68;font-size:26rpx;font-weight:600;line-height:1.4;}
.select-all.disabled {color:#77717d;}
.schedule-fields {display:flex;flex-direction:column;gap:36rpx;margin-top:18rpx;}
.field {margin:0;flex-wrap:wrap;}
.field-label {flex:0 0 auto;}
.field-help {display:inline-flex;align-items:center;gap:6rpx;min-height:36px;}
.field-info-icon {display:block;width:26rpx;height:26rpx;}
.step-options {display:flex;align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:4rpx 36rpx;margin-left:auto;}
.step-option {display:flex;align-items:center;min-height:44px;font-size:26rpx;white-space:nowrap;}
.minimum-field {display:flex;align-items:center;gap:6rpx;flex:0 0 auto;width:180rpx;height:36px;margin-left:auto;padding:0 12rpx;border-radius:12rpx;background:#f4f2f8;}
.minimum-input {flex:1;min-width:0;width:0;height:32px;line-height:32px;padding:0;margin:0;text-align:center;font-size:28rpx;color:#403a48;font-variant-numeric:tabular-nums;}
.field-unit {flex:0 0 auto;font-size:26rpx;color:#615967;}
.choices {flex-wrap:wrap;gap:8rpx 16rpx;margin-top:12rpx;}
.choices label {display:flex;gap:8rpx;align-items:center;min-height:44px;overflow-wrap:anywhere;}
.project-grid {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:20rpx;row-gap:5rpx;width:100%;margin-top:20rpx;}
.project-option {display:flex;align-items:center;gap:10rpx;min-width:0;min-height:36px;padding:0;}
.project-option.wide {grid-column:1 / -1;}
.project-option checkbox {flex:0 0 auto;}
.project-name {min-width:0;overflow-wrap:anywhere;line-height:1.45;}
.schedule-ranges {display:flex;flex-direction:column;gap:12rpx;margin-top:0;}
.range {gap:8rpx;flex-wrap:nowrap;margin:0;}
.range picker {flex:1;min-width:0;}
.range .value {justify-content:center;padding:10rpx 8rpx;font-size:28rpx;}
.range-actions {display:flex;align-items:center;flex:0 0 auto;gap:4rpx;}
.range-actions .range-button {display:flex;align-items:center;justify-content:center;flex:0 0 40px;width:40px;min-width:0;height:44px;margin:0;padding:0;background:#f4f2f8;color:#554b68;border-radius:12rpx;font-size:38rpx;line-height:1;}
.value {background:#f4f2f8;border-radius:12rpx;padding:12rpx 18rpx;min-height:44px;display:flex;align-items:center;}
.add,.retry {width:auto;min-height:44px;padding:8rpx 16rpx;color:#554b68;font-size:26rpx;}
.add-row {align-self:center;width:50%;margin:0 auto 24rpx;}
.add-row .add {box-sizing:border-box;display:flex;align-items:center;justify-content:center;background:#f4f2f8;border-radius:14rpx;margin:0;width:100%;min-width:0;max-width:100%;line-height:1.4;}
.retry {color:#893c48;}

/* Shared weekly and batch colors; form sizing and spacing stay unchanged. */
.weekly .row-head {color:#51475e;}
.weekly .field-label {color:#51475e;}
.weekly .select-all {color:#67528a;}
.weekly .select-all.disabled {color:#77717d;}
.weekly .choice-selected {background:#ffffff;color:#514066;border-radius:12rpx;}
.weekly .minimum-field,.weekly .value {background:#f4f1fb;outline:2rpx solid #9684b0;outline-offset:-2rpx;color:#514066;}
.weekly .minimum-input {color:#514066;}
.weekly .field-unit,.weekly .muted {color:#6a5a7c;}
.weekly .rest-label {color:#7c5b1c;}
.weekly .range-actions .range-remove {background:#f6e9ea;color:#793e44;}
.weekly .range-actions .range-remove:active {background:#ecd4d6;}
.weekly .range-actions .range-add,.weekly .add {background:#e5f2e8;color:#356243;}
.weekly .range-actions .range-add:active,.weekly .add:active {background:#d3e7d8;}
.weekly .range-actions .range-add[disabled],.weekly .add[disabled] {background:#efedf1;color:#77717d;}
.weekly .primary-button {background:#e6e0f8;color:#40374f;}
.weekly .primary-button:active {background:#d8cfef;}
.weekly .retry {background:#f6e9ea;color:#793e44;}
.weekly.is-saving .choice-selected {background:#ffffff;color:#6f6876;}
.weekly.is-saving .minimum-field,.weekly.is-saving .value {background:#efedf1;outline-color:#c7c1cd;color:#6f6876;}
.weekly.is-saving .minimum-input,.weekly.is-saving .field-unit {color:#6f6876;}
