.form { padding:28rpx; margin-bottom:28rpx; }
.title { font-size:28rpx; line-height:1.4; font-weight:600; margin:26rpx 0 16rpx; }
.form>.title:first-child { margin-top:0; }
.upload { border:2rpx dashed #8f7aa3; border-radius:18rpx; padding:28rpx 18rpx; background:#f8f7fc; text-align:center; }
.upload image { width:100%; height:300rpx; }
.upload-label { font-size:30rpx; line-height:1.4; font-weight:600; color:#5c556b; }
.upload .muted { font-size:12px; margin-top:14rpx; }
.error-card { padding:28rpx; color:#7d343b; background:#fff0f0; }
.image-error { margin-top:14rpx; padding:14rpx 18rpx; border-radius:16rpx; color:#7d343b; background:#fff0f0; font-size:24rpx; line-height:1.5; }
input,textarea { width:100%; box-sizing:border-box; background:#f8f7fc; border-radius:16rpx; font-size:28rpx; line-height:1.55; }
input { min-height:48px; padding:18rpx 22rpx; }
textarea { min-height:300rpx; padding:22rpx; line-height:1.6; }
textarea.effect { min-height:160rpx; }
.fields { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20rpx; }
.delete { min-height:48px; display:flex; align-items:center; justify-content:center; color:#7d343b; background:#fff0f0; margin-top:24rpx; padding:14rpx 24rpx; }
.save-button { background:#e6e0f8; color:#40374f; }
.save-button:active { background:#d8cfef; }

@media (max-width: 340px) {
  .fields {
    grid-template-columns: minmax(0, 1fr);
  }
}
