.member-card,
.vip-detail {
  padding: 42rpx 34rpx;
  margin-top: 80rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.3;
  overflow-wrap: anywhere;
  margin-bottom: 16rpx;
}

.member-card button {
  margin-top: 40rpx;
}

.vip-detail {
  background: linear-gradient(135deg, #e6e0f8, #fffdf0);
}

.vip-detail .muted {
  color: #5c556b;
}

.vip-label {
  margin-top: 44rpx;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.25;
  color: #5c556b;
  overflow-wrap: anywhere;
}
