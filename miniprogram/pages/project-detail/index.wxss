.detail-page { width:100%; max-width:520px; min-height:100vh; padding-bottom:calc(180rpx + env(safe-area-inset-bottom)); background:#f8f7fc; margin:0 auto; }
.hero { display:block; width:100%; min-height:400rpx; background:#eee8f4; }
.placeholder { display:flex; justify-content:center; align-items:center; color:#6f6876; }
.image-error-content { display:inline-flex; flex-direction:column; align-items:center; max-width:calc(100% - 48rpx); padding:12rpx 16rpx; gap:8rpx; font-size:24rpx; line-height:1.5; }
.image-retry-label { display:inline-flex; align-items:center; justify-content:center; gap:8rpx; color:#5c556b; white-space:nowrap; }
.retry-icon { width:24rpx; height:24rpx; flex:0 0 24rpx; }
.error-page { margin:24rpx; min-height:auto; border-radius:24rpx; background:#fff0f0; color:#7d343b; line-height:1.55; }
.info-card,.intro-card { position:relative; margin:-40rpx 24rpx 0; padding:34rpx; border-radius:28rpx; background:white; }
.intro-card { margin-top:24rpx; }
.name { font-size:40rpx; line-height:1.3; font-weight:700; overflow-wrap:anywhere; }
.facts { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24rpx 28rpx; margin-top:36rpx; }
.facts > view { min-width:0; }
.facts > view:nth-child(2) { grid-column:1 / -1; grid-row:2; padding-top:24rpx; border-top:2rpx solid #efeff2; }
.facts > view:nth-child(3) { grid-column:2; grid-row:1; }
.value { font-size:28rpx; line-height:1.45; color:#5c556b; font-weight:600; overflow-wrap:anywhere; }
.muted { font-size:24rpx; line-height:1.45; margin-top:12rpx; }
.title { font-size:34rpx; line-height:1.35; font-weight:700; }
.description { display:block; max-width:52em; margin-top:24rpx; font-size:28rpx; line-height:1.8; white-space:pre-wrap; overflow-wrap:anywhere; }
.bottom-bar { position:fixed; bottom:0; left:0; right:0; padding:20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background:rgba(248,247,252,.97); z-index:5; }
.bottom-bar .primary-button { width:100%; max-width:520px; margin:0 auto; }

@media (max-width: 340px) {
  .facts {
    grid-template-columns: minmax(0, 1fr);
  }

  .facts > view:nth-child(2),
  .facts > view:nth-child(3) {
    grid-column: 1;
    grid-row: auto;
    padding-top: 24rpx;
    border-top: 2rpx solid #efeff2;
  }
}
