.therapists-page { padding-bottom:calc(180rpx + env(safe-area-inset-bottom)); }
.title-row { margin:16rpx 0 24rpx; display:flex; align-items:center; justify-content:space-between; gap:24rpx; }
.recycle-entry { min-height:48px; padding:8rpx 0 8rpx 20rpx; display:flex; align-items:center; justify-content:flex-end; gap:10rpx; color:#5c556b; font-size:26rpx; font-weight:600; }
.recycle-icon { width:32rpx; height:32rpx; display:block; }
.subtitle { color:#6f6876; margin:-6rpx 0 28rpx; font-size:26rpx; line-height:1.5; overflow-wrap:anywhere; }
.error-card { padding:24rpx; color:#7d343b; background:#fff0f0; line-height:1.55; }
.therapist-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20rpx; }
.add-card { min-height:440rpx; border:2rpx dashed #8f7aa3; border-radius:24rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; color:#6f5a82; background:#f1edf7; gap:16rpx; line-height:1.4; text-align:center; padding:24rpx; box-sizing:border-box; }
.plus { font-size:72rpx; font-weight: 400; }
.bottom-bar { position:fixed; bottom:0; left:0; right:0; padding:20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background:rgba(248,247,252,.97); z-index:5; }
.bottom-bar .primary-button { margin:0 auto; }
.page-title { min-width:0; font-size:40rpx; line-height:1.3; font-weight:700; overflow-wrap:anywhere; }
